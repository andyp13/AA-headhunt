    <item type="id" name="grid_nav" />
    <item type="id" name="control_center_nav" />
    <item type="id" name="notifications" />
    <item type="id" name="assistant" />
    <item type="id" name="lock_screen_nav_buttons" />
    <item type="id" name="occlusion_buttons" />
</resources>
